<odoo>
    <record id="view_product_responsible_list" model="ir.ui.view">
        <field name="name">product.responsible.list</field>
        <field name="model">product.responsible</field>
        <field name="arch" type="xml">
            <list string="Directorio de Responsables">
                <field name="name"/>
                <field name="company"/>
                <field name="email"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="view_product_responsible_form" model="ir.ui.view">
        <field name="name">product.responsible.form</field>
        <field name="model">product.responsible</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                    <group string="Dirección">
                        <field name="address" nolabel="1" placeholder="Dirección completa..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_responsible" model="ir.actions.act_window">
        <field name="name">Directorio Comercial</field>
        <field name="res_model">product.responsible</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_responsible_root"
              name="Responsables SKU"
              parent="stock.menu_stock_root" 
              sequence="90"
              action="action_product_responsible"
              groups="WB_data_product.group_product_responsible_view"/>

</odoo>