<odoo>
    <data>
        <record id="product_product_coffee_view_inherit" model="ir.ui.view">
            <field name="name">product_product_coffee_view</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
              <xpath expr="//field[@name='data_moq']" position="after">
                  <field name="loading_qty_" string="Cantidad de carga"/>
              </xpath>
              <xpath expr="//field[@name='nacional_import']" position="after">
                  <field name="data_supplier_code" string="Código de proveedor"/>
              </xpath>
              <xpath expr="//group[@name='planing']" position="inside">
                  <field name="target_items" string="Venta objetivo"/>
                  <field name="purchase_active" string="Compra activa"/>
              </xpath>
              <xpath expr="//field[@name='substatus']" position="after">
                  <field name="variant" string="Variante"/>
              </xpath>
            </field>
        </record>
    </data>
</odoo>