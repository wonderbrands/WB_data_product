<odoo>
    <data>
        <record id="product_product_form_inherit" model="ir.ui.view">
            <field name="name">product_product_inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='comercial']" position="after">
                    <group string="Costos">
                        <field name="revised_cost" widget='monetary'/>
                    </group>
                </xpath>
                <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                    <group string="Medidas calculadas de producto" invisible="[('is_kit', '=', False)]">
                        <label for="calculated_weight"/>
                        <div class="o_row" name="calculated_weight">
                            <field name="calculated_weight"/>
                            <span>kg</span>
                        </div>
                        <label for="calculated_volume"/>
                        <div class="o_row" name="calculated_volume">
                            <field name="calculated_volume"/>
                            <span>Litros</span>
                        </div>
                    </group>
                </xpath>
                <xpath expr="//group[@name='status']" position="after">
                    <group string="Stock">
                        <field name="stock_real"/>
                        <field name="stock_urrea"/>
                    </group>
                </xpath>
                <notebook>
                    <page name="combo" string="Componentes" invisible="[('is_kit', '=', False)]">
                        <group string='Lista de materiales'>
                            <group>

                                <label for="combo_qty"/>
                                <div class="o_row" name="combo_qty">
                                    <field name="combo_qty"/>
                                    <span>combos pueden crearse</span>
                                </div>
                            </group>
                            <field name="sub_product_line_ids">
                                <list edit="0" create="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="stock_qty"/>

                                </list>
                            </field>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>